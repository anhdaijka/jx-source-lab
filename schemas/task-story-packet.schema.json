{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JX Task Story Packet R2.1",
  "type": "object",
  "required": [
    "schema_version",
    "generator",
    "packet_id",
    "story_classification",
    "task_family",
    "subtask",
    "topology",
    "characters_and_npcs",
    "extracted_evidence",
    "source_claims",
    "entities_and_systems",
    "provenance_and_evidence"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "generator": {"type": "string"},
    "packet_id": {"type": "string"},
    "story_classification": {
      "enum": [
        "MAIN_STORY",
        "SIDE_STORY",
        "FACTION_STORY",
        "INSTANCE_STORY",
        "FEATURE_LORE",
        "WORLD_LIFE",
        "REPEATABLE_DAILY",
        "TUTORIAL_OR_UI_HEAVY",
        "UNCLASSIFIED"
      ]
    },
    "task_family": {
      "type": "object",
      "required": ["id_hex", "id_dec", "name", "classification"],
      "properties": {
        "id_hex": {"type": "string"},
        "id_dec": {"type": "integer"},
        "name": {"type": "string"},
        "classification": {"type": "string"},
        "description": {"type": "string"}
      }
    },
    "subtask": {
      "type": "object",
      "required": ["id_hex", "id_dec", "name_inline", "name_standalone", "order_in_family"],
      "properties": {
        "id_hex": {"type": "string"},
        "id_dec": {"type": "integer"},
        "name_inline": {"type": "string"},
        "name_standalone": {"type": "string"},
        "order_in_family": {"type": "integer", "minimum": 0}
      }
    },
    "topology": {
      "type": "object",
      "required": ["prior_subtask_ids", "next_subtask_ids", "incoming_edges", "outgoing_edges"],
      "properties": {
        "prior_subtask_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "next_subtask_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "incoming_edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "target", "edge_type"],
            "properties": {
              "source": {"type": "string"},
              "target": {"type": "string"},
              "edge_type": {
                "enum": [
                  "MANAGED_ORDER",
                  "EXPLICIT_ASK_ACCEPT",
                  "SCRIPT_TRANSITION",
                  "CONDITION_EDGE",
                  "INFERRED_SEQUENCE"
                ]
              },
              "detail": {"type": "string"}
            }
          }
        },
        "outgoing_edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "target", "edge_type"],
            "properties": {
              "source": {"type": "string"},
              "target": {"type": "string"},
              "edge_type": {
                "enum": [
                  "MANAGED_ORDER",
                  "EXPLICIT_ASK_ACCEPT",
                  "SCRIPT_TRANSITION",
                  "CONDITION_EDGE",
                  "INFERRED_SEQUENCE"
                ]
              },
              "detail": {"type": "string"}
            }
          }
        }
      }
    },
    "characters_and_npcs": {
      "type": "object",
      "required": ["giver_npc", "turn_in_npc", "involved_npcs"],
      "properties": {
        "giver_npc": {
          "type": ["object", "null"],
          "properties": {
            "npc_id": {"type": "string"},
            "name": {"type": "string"},
            "class_name": {"type": "string"}
          }
        },
        "turn_in_npc": {
          "type": ["object", "null"],
          "properties": {
            "npc_id": {"type": "string"},
            "name": {"type": "string"},
            "class_name": {"type": "string"}
          }
        },
        "involved_npcs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["npc_id", "name", "role_or_function"],
            "properties": {
              "npc_id": {"type": "string"},
              "name": {"type": "string"},
              "class_name": {"type": "string"},
              "role_or_function": {"type": "string"}
            }
          }
        }
      }
    },
    "extracted_evidence": {
      "type": "object",
      "required": [
        "task_description",
        "dialogue_pop",
        "dialogue_start",
        "dialogue_prize",
        "evidence_nodes"
      ],
      "properties": {
        "task_description": {"type": "string"},
        "dialogue_pop": {"type": ["object", "null"]},
        "dialogue_start": {"type": ["object", "null"]},
        "dialogue_prize": {"type": ["object", "null"]},
        "evidence_nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "evidence_id",
              "node_type",
              "speaker_id",
              "speaker_resolution",
              "text",
              "evidence_class"
            ],
            "properties": {
              "evidence_id": {"type": "string"},
              "step_index": {"type": "integer"},
              "grid_index": {"type": "integer"},
              "node_type": {
                "enum": [
                  "TASK_DESCRIPTION",
                  "NPC_DIALOGUE",
                  "PLAYER_TASK_NARRATION",
                  "SYSTEM_UI_TEXT",
                  "OBJECTIVE",
                  "SCRIPT_TRANSITION"
                ]
              },
              "speaker_id": {"type": ["string", "null"]},
              "speaker_name": {"type": ["string", "null"]},
              "speaker_resolution": {
                "enum": [
                  "EXPLICIT_NPC_TAG",
                  "EXPLICIT_PLAYER_TAG",
                  "CONTEXTUAL_DIALOGNPC",
                  "UNRESOLVED"
                ]
              },
              "text": {"type": "string"},
              "purpose": {"type": "string"},
              "evidence_class": {"type": "string"}
            }
          }
        }
      }
    },
    "source_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "claim_type", "claim_text", "status", "evidence_refs"],
        "properties": {
          "claim_id": {"type": "string"},
          "claim_type": {"type": "string"},
          "claim_text": {"type": "string"},
          "status": {"enum": ["DIRECT", "DERIVED", "INFERRED", "UNKNOWN"]},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "entities_and_systems": {
      "type": "object",
      "required": ["items", "monsters_or_targets", "locations_or_maps", "faction_references", "martial_references"],
      "properties": {
        "items": {"type": "array"},
        "monsters_or_targets": {"type": "array"},
        "locations_or_maps": {"type": "array"},
        "faction_references": {"type": "array", "items": {"type": "string"}},
        "martial_references": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance_and_evidence": {
      "type": "object",
      "required": ["evidence_class", "source_records", "parser_version", "conflicts_or_drift"],
      "properties": {
        "evidence_class": {"type": "string"},
        "source_records": {"type": "array"},
        "parser_version": {"type": "string"},
        "conflicts_or_drift": {"type": "array"}
      }
    }
  }
}

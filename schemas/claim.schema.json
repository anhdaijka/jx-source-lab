{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JX Research Claim",
  "type": "object",
  "required": [
    "claim_id",
    "claim",
    "status",
    "evidence"
  ],
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "status": {
      "enum": [
        "VERIFIED_DIRECT",
        "VERIFIED_CROSS_SOURCE",
        "STRONG",
        "INFERENCE",
        "UNKNOWN",
        "CONFLICT",
        "EDITION_DRIFT"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}